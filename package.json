{
  "name": "blueprint-paper",
  "version": "0.7.0",
  "description": "A blueprint-themed, CSS-first UI kit. Interfaces drawn like technical drawings.",
  "license": "MIT",
  "homepage": "https://streamlinedesign.github.io/blueprint-paper/",
  "repository": {
    "type": "git",
    "url": "https://github.com/streamlinedesign/blueprint-paper.git"
  },
  "keywords": [
    "css",
    "framework",
    "ui-kit",
    "design-system",
    "blueprint",
    "switch",
    "toggle"
  ],
  "type": "module",
  "style": "dist/blueprint-paper.css",
  "main": "dist/blueprint-paper.css",
  "exports": {
    ".": "./dist/blueprint-paper.css",
    "./min": "./dist/blueprint-paper.min.css",
    "./tokens": "./dist/tokens.css",
    "./base": "./dist/base.css",
    "./components/*": "./dist/components/*",
    "./themes/*": "./dist/themes/*",
    "./js": "./dist/blueprint-paper.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "stylelint \"src/**/*.css\" \"docs/docs.css\"",
    "check": "npm run build && git diff --quiet -- dist docs/blueprint-paper.css docs/blueprint-paper.js || (echo 'dist is out of date: run npm run build and commit' && exit 1)",
    "dev": "npx -y serve docs -l 4321",
    "test": "node tests/check.mjs",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "lightningcss": "^1.33.0",
    "playwright": "^1.63.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
